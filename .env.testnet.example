# =============================================================================
# Botragram Testnet Credentials
# Copy this file to .env.testnet and replace the placeholders.
# =============================================================================

# Binance Spot Test Network or Futures Demo credentials
BINANCE_API_KEY=your_binance_testnet_api_key_here
BINANCE_API_SECRET=your_binance_testnet_api_secret_here
BINANCE_TESTNET=true

# Bybit Testnet
BYBIT_API_KEY=your_bybit_testnet_api_key_here
BYBIT_API_SECRET=your_bybit_testnet_api_secret_here
BYBIT_TESTNET=true

# OKX Demo
OKX_API_KEY=your_okx_testnet_api_key_here
OKX_API_SECRET=your_okx_testnet_api_secret_here
OKX_PASSPHRASE=your_okx_testnet_passphrase_here
OKX_TESTNET=true

# Bitget Demo
BITGET_API_KEY=your_bitget_testnet_api_key_here
BITGET_API_SECRET=your_bitget_testnet_api_secret_here
BITGET_PASSPHRASE=your_bitget_testnet_passphrase_here
BITGET_TESTNET=true
