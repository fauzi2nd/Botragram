{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Pytest Local",
            "type": "shell",
            "command": "pytest",
            "args": [
                "--basetemp=.pytest-runtime-local",
                "-o",
                "cache_dir=.cache/pytest-runtime-local"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}