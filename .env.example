# =============================================================================
# Botragram Environment Configuration (.env.example)
# =============================================================================

# Supported values: TESTNET, MAINNET
# Credentials are loaded from .env.testnet or .env.mainnet.
BOTRAGRAM_PROFILE=MAINNET

# Optional bootstrap selector for the dedicated autonomous TESTNET soak base file.
# Set this in the process environment before startup, not here: dotenv is loaded
# only after this selection is resolved.
# BOTRAGRAM_ENV_FILE=.env.autonomous_testnet_soak

# Active Exchange: BINANCE, BYBIT, or BITGET
ACTIVE_EXCHANGE=BITGET

# Telegram Bot Credentials
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Application Settings
TRADE_MODE=LIVE
# Enable only PAPER market-wide opportunity execution.
AUTONOMOUS_EXECUTION_ENABLED=false
# Base explicit opt-in required for autonomous LIVE entry.
AUTONOMOUS_LIVE_ENTRY_ENABLED=true
# Additional fail-closed opt-in required only for autonomous MAINNET entry.
AUTONOMOUS_MAINNET_ENTRY_ENABLED=true
# Optional: single_symbol, autonomous_paper, autonomous_live, or human_confirmed_paper.
# Leave blank to preserve the legacy autonomous flag behavior.
EXECUTION_POLICY=autonomous_live
# Supported strategy types:
# Scalping:     ema_scalping, rsi_bb_scalping, vwap_breakout, ny_4h_range_scalping (Auto-TF: 5m | Default RRR 1:2)
# Price Action: choch_fvg, high_confluence_exhaustion, liquidity_sweep_exhaustion, choch_rsi_bb_hybrid, morph, pinbar_engulfing_ema_rsi, botragram_origin (Auto-TF: 5m/15m)
# Trend:        ema_cross, ema_rsi, ichimoku_cloud, supertrend, adx_trend, bollinger_breakout, quad_confluence (Auto-TF: 15m | Default RRR 1:2)
# Swing:        macd_swing (Auto-TF: 1h | Default RRR 1:2)
STRATEGY_TYPE=pinbar_engulfing_ema_rsi
# Set to true to invert all generated signals (BUY -> SELL, SELL -> BUY)
INVERT_SIGNALS=false
# Minimum signal confidence threshold (0.0 to 1.0, e.g. 0.80 for 80% confidence)
MIN_SIGNAL_CONFIDENCE=0.65
# =============================================================================
# TIMEFRAME CONFIGURATION
# =============================================================================
# ------------------------------------------------------------
# 1. GLOBAL MARKET TIMEFRAME
# ------------------------------------------------------------
# Base market/candle timeframe. Strategies without a specific <STRATEGY>_INTERVAL use this.
GLOBAL_MARKET_INTERVAL=5m

# Deprecated compatibility alias (use GLOBAL_MARKET_INTERVAL instead):
# MARKET_INTERVAL=5m

LOG_LEVEL=INFO

# =============================================================================
# Strategy Risk Profiles (Optional Custom Override - Default RRR 1:2 / 1:2.5)
# =============================================================================
# Botragram secara otomatis menerapkan RRR optimal untuk setiap kategori strategi:
#   • Scalping:     SL 0.5% / TP 1.0% (RRR 1:2)
#   • Price Action: SL 1.0% / TP 2.5% (RRR 1:2.5) -> choch_fvg, morph, lse
#   • Trend:        SL 1.5% / TP 3.0% (RRR 1:2)
#   • Swing:        SL 2.5% / TP 5.0% (RRR 1:2)
#
# Buka tanda pagar (#) di bawah HANYA jika Anda ingin melakukan custom override:
#
# 1. Scalping strategies override (rsi_bb_scalping, ema_scalping, vwap_breakout)
# SCALPING_INTERVAL=5m
SCALPING_FAST_PERIOD=5
SCALPING_SLOW_PERIOD=13
SCALPING_REQUIRE_TREND_FILTER=true
SCALPING_TREND_PERIOD=200
SCALPING_STOP_LOSS_PCT=0.025
SCALPING_TAKE_PROFIT_PCT=0.03
#
# 2. Trend following strategies override (ichimoku_cloud, supertrend, ema_cross, adx_trend, ema_rsi, bollinger_breakout)
# TREND_INTERVAL=15m
# TREND_STOP_LOSS_PCT=0.015
# TREND_TAKE_PROFIT_PCT=0.03
#
# 3. Swing trading strategies override (macd_swing)
# SWING_INTERVAL=1h
# SWING_STOP_LOSS_PCT=0.025
# SWING_TAKE_PROFIT_PCT=0.05
#
# 4. Global fallback exits override (ratios: 0.02 = 2%, 0.04 = 4%)
# STOP_LOSS_PCT=0.02
# TAKE_PROFIT_PCT=0.04
#
# 5a. Smart Money Concepts Strategy Parameters (choch_fvg)
# CHOCH_INTERVAL=5m
# CHOCH_SWING_WINDOW=5          # Lookback bar window untuk mendeteksi Swing High / Swing Low (default: 5)
# CHOCH_FVG_LOOKBACK=20         # Jendela candle mundur untuk memetakan Fair Value Gap / Imbalance (default: 20)
# CHOCH_MIN_BODY_RATIO=0.50     # Rasio minimal body candle breakout (displacement quality) (default: 0.50)
# CHOCH_VOLUME_MULTIPLIER=1.20  # Rasio lonjakan volume candle displacement vs SMA volume (default: 1.20)
#
# 5b. Market Orderflow Regime & Price-Hunt Parameters (morph)
# MORPH_INTERVAL=15m
# MORPH_SWING_LOOKBACK=15       # Lookback bar window untuk swing high / swing low
# MORPH_FVG_LOOKBACK=20         # Jendela candle mundur untuk FVG retest
# MORPH_USE_FVG=true            # Aktifkan konfirmasi Fair Value Gap
# MORPH_MIN_WICK_RATIO=0.50     # Rasio minimal ekor rejection pinbar (50%)
# MORPH_VOLUME_MULTIPLIER=1.15  # Pengali lonjakan volume minimal
# MORPH_ATR_MULTIPLIER_SL=0.8   # Buffer volatilitas ATR pada stop loss
# MORPH_RISK_REWARD_RATIO=2.0   # Target Risk-Reward Ratio (1:2.0)
# MORPH_TREND_PERIOD=200        # Periode EMA tren makro
# MORPH_INTERMEDIATE_TREND_PERIOD=50 # Periode EMA tren intermediate
# MORPH_REQUIRE_TREND_FILTER=true # Wajibkan sinyal searah tren makro EMA 200/50
# MORPH_MIN_NATR_THRESHOLD=0.0020 # Minimal NATR (filter pasar mati/sideways flat)
#
# 5c. Pinbar & Engulfing Candlestick Parameters (pinbar_engulfing_ema_rsi)
# Timeframe strategi (didukung: PIER_INTERVAL / PIER_TIMEFRAME / PIER_TF)
PIER_INTERVAL=5m
PIER_TREND_PERIOD=200
PIER_PULLBACK_PERIOD=21
PIER_REQUIRE_KEY_LEVEL_LOCATION=true # Tolak pinbar mengambang di ruang hampa
PIER_REQUIRE_TREND_FILTER=true       # Filter dual EMA (pullback EMA >= macro EMA)
PIER_MIN_NATR_THRESHOLD=0.0020       # Filter volatilitas pasar mati/flat
PIER_RSI_LONG_MIN=38.0               # Zona RSI Long diperluas untuk menangkap pullback dalam
PIER_RSI_LONG_MAX=58.0               # Batas atas RSI Long agar tidak membeli di overbought
PIER_RSI_SHORT_MIN=42.0              # Batas bawah RSI Short agar tidak menjual di oversold
PIER_RSI_SHORT_MAX=62.0              # Zona RSI Short diperluas untuk menangkap rally pullback
PIER_STOP_LOSS_PCT=0.018             # SL 1.8% memberi ruang napas dari wick hunting pada altcoin
PIER_TAKE_PROFIT_PCT=0.036           # TP 3.6% menjaga Risk-Reward Ratio tetap 1:2
PIER_USE_MACD=true
PIER_USE_STOCH_RSI=true
PIER_LOCATION_TOLERANCE_PCT=0.030    # Toleransi lokasi persentase (default: 3%)
PIER_LOCATION_ATR_MULTIPLIER=1.0     # Toleransi lokasi berbasis ATR (opsional)
PIER_PULLBACK_PROXIMITY_PCT=0.006    # Toleransi kedekatan pullback EMA21 (default: 0.6%)
PIER_PULLBACK_ATR_MULTIPLIER=0.5     # Toleransi kedekatan pullback berbasis ATR (opsional)
PIER_PINBAR_MIN_RANGE_ATR=0.5        # Ukuran range minimal pinbar relatif terhadap ATR (opsional)
PIER_ENGULFING_MIN_BODY_ATR=0.5      # Ukuran body minimal engulfing relatif terhadap ATR (opsional)
PIER_REQUIRE_CONFIRMATION=false      # Mode konfirmasi breakout candle berikutnya (default: false)
#
# 5d. New York 4H Range Scalping Parameters (ny_4h_range_scalping)
# NY_RANGE_INTERVAL=5m
# NY_RANGE_RISK_REWARD_RATIO=0.8              # Target Risk-Reward Ratio (1:0.8)
# NY_RANGE_MAX_SL_PCT=0.03                     # Batas maksimal jarak Stop Loss (3.0%)
# NY_RANGE_MIN_SL_PCT=0.015                    # Batas minimal jarak Stop Loss (1.5%)
# NY_RANGE_FALLBACK_SL_PCT=0.015               # Fallback Stop Loss jika swing invalid (1.5%)
# NY_RANGE_MAX_BREAKOUT_BARS=12                # Maksimal candle 5M breakout sebelum re-entry
# NY_RANGE_MIN_CONFIDENCE=0.75                 # Threshold minimal confidence sinyal (75%)
# NY_RANGE_BASE_CONFIDENCE=0.70                # Base confidence sinyal setup valid (70%)
# NY_RANGE_USE_VOLUME_FILTER=true              # Aktifkan konfirmasi volume pada candle re-entry
# NY_RANGE_VOLUME_PERIOD=20                    # Periode SMA volume (20 candle 5M)
# NY_RANGE_VOLUME_MULTIPLIER=1.0               # Multiplier volume vs SMA (1.0x)
# NY_RANGE_VOLUME_CONFIDENCE_BONUS=0.10        # Bonus confidence jika volume terkonfirmasi (+10%)
# NY_RANGE_REQUIRE_VOLUME_CONFIRMATION=false   # Strict reject jika volume tidak terkonfirmasi
# NY_RANGE_REQUIRE_TREND_FILTER=true           # Filter arah tren (EMA 50 pada close)
# NY_RANGE_TREND_EMA_PERIOD=50                 # Periode EMA untuk filter tren
# NY_RANGE_USE_RSI_FILTER=true                 # Filter momentum RSI untuk validasi re-entry
# NY_RANGE_RSI_PERIOD=14                       # Periode RSI (14 candle 5M)
# NY_RANGE_RSI_LONG_MAX=54.0                   # Batas maksimal RSI untuk entry Long
# NY_RANGE_RSI_SHORT_MIN=44.0                  # Batas minimal RSI untuk entry Short
#
# 5e. Botragram Origin Parameters (botragram_origin)
# Fokus komprehensif pada pola candlestick (Single, Dual, Triple) dengan hook TA
# Timeframe strategi (didukung: ORIGIN_INTERVAL / ORIGIN_TIMEFRAME / ORIGIN_TF / BOTRAGRAM_TF / BOTRAGRAM_INTERVAL)
ORIGIN_INTERVAL=3m
ORIGIN_RISK_REWARD_RATIO=1.5                 # Target Risk-Reward Ratio (1:1.5)
ORIGIN_MIN_SL_PCT=0.010                    # Batas minimal jarak Stop Loss (0.8%)
ORIGIN_MAX_SL_PCT=0.030                      # Batas maksimal jarak Stop Loss (3.0%)
ORIGIN_FALLBACK_SL_PCT=0.015                 # Fallback Stop Loss jika swing invalid (1.5%)
ORIGIN_STOP_LOSS_PCT=0.03                   # Override Stop Loss eksplisit (default: max_sl_pct 3.0%)
ORIGIN_TAKE_PROFIT_PCT=0.045            # Override Take Profit eksplisit (default: 4.5%)
ORIGIN_MIN_CONFIDENCE=0.75                  # Threshold minimal confidence sinyal (70%)
ORIGIN_USE_TREND_FILTER=true               # Filter arah tren makro (false agar tidak kontradiksi dengan BB Reversal)
ORIGIN_TREND_EMA_PERIOD=14                 # Periode EMA untuk filter tren
ORIGIN_USE_VOLUME_FILTER=true               # Filter konfirmasi volume
ORIGIN_VOLUME_PERIOD=20                      # Periode SMA volume
ORIGIN_VOLUME_MULTIPLIER=1.1                 # Multiplier lonjakan volume vs SMA
ORIGIN_USE_RSI_FILTER=false                  # Filter momentum RSI
ORIGIN_RSI_PERIOD=14                         # Periode RSI
ORIGIN_RSI_LONG_MAX=90.0                     # Batas maksimal RSI untuk entry Long
ORIGIN_RSI_SHORT_MIN=20.0                    # Batas minimal RSI untuk entry Short
ORIGIN_REQUIRE_RSI_DIRECTION=true           # Wajib RSI berbalik arah (Long: RSI naik, Short: RSI turun)
ORIGIN_USE_BB_FILTER=true                  # Filter Bollinger Bands (Short: sentuh Upper BB lalu reject)
ORIGIN_BB_PERIOD=20                         # Periode Bollinger Bands
ORIGIN_BB_STD_DEV=2.0                       # Multiplier deviasi standar Bollinger Bands
ORIGIN_USE_MACD_FILTER=true                # Filter arah momentum MACD (Short: MACD menurun)
ORIGIN_MACD_FAST_PERIOD=12                  # Periode Fast EMA MACD
ORIGIN_MACD_SLOW_PERIOD=26                  # Periode Slow EMA MACD
ORIGIN_MACD_SIGNAL_PERIOD=9                 # Periode Signal EMA MACD
ORIGIN_USE_PSAR_FILTER=false                 # Filter Parabolic SAR Aktif
ORIGIN_PSAR_MAX_PROXIMITY_PCT=0.012         # Toleransi jarak SAR (0.8% untuk menyaring pisau jatuh)

# 6. Multi-Timeframe (MTF) Trend Confirmation
# Memfilter sinyal agar searah dengan tren pada timeframe yang lebih tinggi (default: 15m/4h, EMA 50)
MTF_CONFIRMATION_ENABLED=true
MTF_TIMEFRAME=15m
MTF_EMA_PERIOD=50

# 7. Advanced Opportunity Discovery Filters (Liquidity & Extreme Volatility)
# Menyaring koin illiquid dan koin dengan volatilitas abnormal/ekstrem
DISCOVERY_FILTER_EXTREME_VOLATILITY=true
DISCOVERY_MAX_CANDLE_VOLATILITY_PCT=0.15
DISCOVERY_FILTER_MIN_LIQUIDITY=true
DISCOVERY_MIN_QUOTE_VOLUME_USDT=1000
DISCOVERY_USE_DYNAMIC_VOLUME=true
DISCOVERY_VOLUME_SMA_PERIOD=20
DISCOVERY_MIN_24H_TURNOVER_USDT=288000

# =============================================================================
# 8. Derivatives Orderflow Filters (Open Interest & Funding Rate Crowding)
# =============================================================================
# A. Open Interest (OI) Confluence:
# Mengonfirmasi sinyal dengan dinamika Open Interest (Long Buildup vs Short Covering, Short Buildup vs Long Liquidation)
USE_OPEN_INTEREST=true
MIN_OI_CHANGE_PCT=0.0005
REQUIRE_OI_CONFLUENCE=true

# B. Funding Rate Crowding Sentiment Filter:
# Menolak BUY jika pasar over-leveraged long (> +0.05%), menolak SELL jika over-leveraged short (< -0.05%)
FILTER_FUNDING_SENTIMENT=true
MAX_LONG_FUNDING_RATE=0.0005
MIN_SHORT_FUNDING_RATE=-0.0005
REQUIRE_FUNDING_SENTIMENT=true

# C. Long-Short Account Ratio Sentiment Filter:
# Menolak BUY jika mayoritas akun net long (> 70%), menolak SELL jika mayoritas akun net short (< 30%)
# Multi-timeframe confirmation: memeriksa rasio 15m dan 1h secara bersamaan
FILTER_ACCOUNT_RATIO=true
MAX_LONG_ACCOUNT_RATIO=0.70
MIN_SHORT_ACCOUNT_RATIO=0.30
REQUIRE_ACCOUNT_RATIO_CONFLUENCE=true
CONFIRM_HTF_ACCOUNT_RATIO=true
ACCOUNT_RATIO_HTF_PERIOD=1h

# D. Benchmark Market Trend Filter (BTC Trend Alignment):
# Menolak SHORT pada altcoin jika BTC sedang uptrend, menolak BUY jika BTC downtrend
BTC_TREND_FILTER_ENABLED=true
BTC_TREND_INTERVAL=5m
BTC_TREND_EMA_PERIOD=50

# =============================================================================
# Portfolio and MARKET-entry Safeguards
# =============================================================================
# For autonomous LIVE these values are both the startup runtime values and the
# immutable hard ceilings. Telegram may lower/raise durable runtime values only
# within these ceilings while trading is PAUSED; no restart is required.
MAX_OPEN_POSITIONS=10
MAX_POSITION_SIZE_USDT=50
RISK_PER_TRADE_PCT=0.03
MAX_DRAWDOWN_PCT=0.05
LEVERAGE=3
# Reject execution references older than this limit or with a wider spread.
MAX_EXECUTABLE_QUOTE_AGE_MS=15000
MAX_SPREAD_BPS=20

# Stepped Position Protection (SL+ Profit Lock & Breakeven)
# Mengaktifkan penggeseran stop-loss berjenjang (Step 2..6: 30%, 45%, 60%, 75%, 90% progress mengunci 10%, 25%, 40%, 55%, 70%)
STEPPED_STOP_ENABLED=false
# Threshold progress TP berjenjang untuk menggeser SL+ (pisahkan dengan koma)
STEPPED_STOP_THRESHOLDS=0.30,0.45,0.60,0.75,0.90
# Jarak lag profit yang dikunci di belakang step yang tercapai (default: 0.20 / 20%)
STEPPED_STOP_LOCKED_LAG=0.20
# Mengunci stop-loss ke Breakeven+ ketika profit (PnL/ROI) mencapai threshold dari margin (e.g. 0.40 = 40%)
BREAKEVEN_ROI_THRESHOLD=0.50
# Buffer biaya trading yang ditambahkan ke entry price saat breakeven (default: 0.0016 / 0.16%)
BREAKEVEN_FEE_BUFFER=0.0016

# Partial Take Profit (Scaling Out)
# Mengamankan profit sebagian saat progress TP tercapai dan memindahkan stop-loss ke Breakeven
PARTIAL_TP_ENABLED=true
PARTIAL_TP_RATIO=0.80
# Progress jarak Entry -> TP yang memicu eksekusi Partial TP (default: 0.50 / 50%, profil ini: 0.80 / 80%)
PARTIAL_TP_TRIGGER_PROGRESS=0.80

# Early In-Flight Position Exit (Invalidation Guard)
# Dinonaktifkan agar setup pada TF 15m memiliki ruang bernapas tanpa terpotong fluktuasi candle minor
ENABLE_EARLY_POSITION_EXIT=false
EARLY_EXIT_MIN_CONFIDENCE=0.75
EARLY_EXIT_CHECK_CANDLESTICK_REVERSAL=false
EARLY_EXIT_CHECK_OPPOSITE_SIGNAL=false

# Smart Dynamic Position Sizing & Adaptive Leverage
# Menyesuaikan ukuran posisi berdasarkan skor keyakinan sinyal (Confidence) dan volatilitas aset
DYNAMIC_SIZING_ENABLED=true
CONFIDENCE_SIZING_ENABLED=true
BASELINE_CONFIDENCE=0.70
MAX_CONFIDENCE_MULTIPLIER=1.50
DYNAMIC_LEVERAGE_ENABLED=true
MIN_LEVERAGE=3
MAX_LEVERAGE=8

# Dynamic Slot-Based Margin Allocation (Equal Margin Budget per Available Slot)
# Membagi margin bebas secara merata ke sisa slot posisi agar seluruh slot dapat terbuka
SLOT_SIZING_ENABLED=true
SLOT_MARGIN_BUFFER_PCT=0.05
MIN_ORDER_NOTIONAL_USDT=15.0

# Volatility-Adjusted Dynamic Position Sizing
# Menyesuaikan ukuran posisi berdasarkan volatilitas pasar relatif terhadap baseline
VOLATILITY_SIZING_ENABLED=true
BASELINE_VOLATILITY_PCT=0.02

# Autonomous LIVE ranked discovery rotation.
# DISCOVERY_UNIVERSE_LIMIT is retained for compatibility/telemetry; autonomous
# LIVE rotates bounded batches across the complete active ranked Futures universe.
DISCOVERY_UNIVERSE_LIMIT=750
DISCOVERY_BATCH_SIZE=10
# Optional upper ceiling to cap the discovery universe to top N liquid symbols
# (e.g. 150 or 200) instead of scanning the full 500+ symbol exchange list.
DISCOVERY_MAX_UNIVERSE_SYMBOLS=750
# Optional autonomous discovery cadence in seconds; leave blank for automatic
# candle-close synchronization with the active strategy interval.
DISCOVERY_CADENCE_SECONDS=1
# Pacing delay between sequential candle fetches during discovery (seconds).
# Protects against exchange rate limits (e.g. Bybit 10-20 req/s) when scanning large universes.
DISCOVERY_CANDLE_DELAY_SECONDS=0.18

# Automated Database Candle Retention & Pruning
# CANDLE_RETENTION_DAYS: Hapus data candlestick lokal yang lebih tua dari N hari (default: 7)
# CANDLE_PRUNING_INTERVAL_HOURS: Frekuensi eksekusi background pruning & PRAGMA optimize dalam jam (default: 6)
CANDLE_RETENTION_DAYS=7
CANDLE_PRUNING_INTERVAL_HOURS=6

# =============================================================================
# Binance Product
# =============================================================================
# Supported values: SPOT, FUTURES (USD(S)-M perpetual futures)
BINANCE_MARKET_TYPE=FUTURES

# =============================================================================
# Bybit Product
# =============================================================================
# Supported values: SPOT, FUTURES (USDT perpetual linear futures)
BYBIT_MARKET_TYPE=FUTURES
# Set BYBIT_DEMO=true if your API key was created on Bybit Demo Trading
# (api-demo.bybit.com). Demo keys do NOT work on Testnet or Mainnet.
# BYBIT_TESTNET must be false when using demo mode.
# BYBIT_DEMO=false

# =============================================================================
# Bitget Product
# =============================================================================
# Supported values: FUTURES (USDT-M perpetual futures), CFD (Forex, Commodities, Indices)
BITGET_MARKET_TYPE=FUTURES
# Bitget credentials (opsional fallback jika tidak menggunakan profile .env.mainnet / .env.testnet):
# BITGET_API_KEY=your_bitget_api_key_here
# BITGET_API_SECRET=your_bitget_api_secret_here
# BITGET_PASSPHRASE=your_bitget_passphrase_here
# BITGET_TESTNET=false
