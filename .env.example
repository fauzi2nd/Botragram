# =============================================================================
# Botragram Environment Configuration Template (.env.example)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CORE SYSTEM & PROFILE
# -----------------------------------------------------------------------------
# Mode Profil: TESTNET atau MAINNET
# Kredensial spesifik dimuat dari .env.testnet atau .env.mainnet
BOTRAGRAM_PROFILE=TESTNET

# Bootstrap selector opsional untuk soak test dedicated:
# BOTRAGRAM_ENV_FILE=.env.autonomous_testnet_soak

# Bursa Aktif: BINANCE, BYBIT, atau BITGET
ACTIVE_EXCHANGE=BITGET

# Mode Margin Futures: ISOLATED atau CROSSED
MARGIN_MODE=ISOLATED
BITGET_MARGIN_MODE=ISOLATED

# Simbol Pasar Utama (Opsional: bot otomatis memilih XAUUSD untuk CFD, BTCUSDT untuk Futures):
# CFD_SYMBOL=XAUUSD
# FUTURES_SYMBOL=BTCUSDT
# SPOT_SYMBOL=BTCUSDT
# SYMBOL=BTCUSDT
# BASE_ASSET=BTC
# QUOTE_ASSET=USDT


# -----------------------------------------------------------------------------
# 2. TELEGRAM BOT NOTIFICATIONS
# -----------------------------------------------------------------------------
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here


# -----------------------------------------------------------------------------
# 3. TRADING MODE & AUTONOMOUS POLICIES
# -----------------------------------------------------------------------------
# Mode Eksekusi: PAPER (simulasi lokal) atau LIVE (order nyata ke bursa)
TRADE_MODE=PAPER

# Kontrol Otomasi Eksekusi:
# AUTONOMOUS_EXECUTION_ENABLED: Eksekusi market-wide khusus mode PAPER
AUTONOMOUS_EXECUTION_ENABLED=false
# AUTONOMOUS_LIVE_ENTRY_ENABLED: Izin eksplisit untuk entry otomatis mode LIVE
AUTONOMOUS_LIVE_ENTRY_ENABLED=false
# AUTONOMOUS_MAINNET_ENTRY_ENABLED: Izin pengaman ganda khusus MAINNET LIVE
AUTONOMOUS_MAINNET_ENTRY_ENABLED=false

# Kebijakan Eksekusi (single_symbol, autonomous_paper, autonomous_live, human_confirmed_paper):
EXECUTION_POLICY=single_symbol


# -----------------------------------------------------------------------------
# 4. ACTIVE STRATEGY & GLOBAL TIMEFRAME
# -----------------------------------------------------------------------------
# Pilihan Strategi:
#   • Scalping:     ema_scalping, rsi_bb_scalping, vwap_breakout, ny_4h_range_scalping
#   • Price Action: pinbar_engulfing_ema_rsi, choch_fvg, morph, botragram_origin, lse
#   • Trend:        ema_cross, ema_rsi, ichimoku_cloud, supertrend, adx_trend, quad_confluence
#   • Swing:        macd_swing
STRATEGY_TYPE=pinbar_engulfing_ema_rsi

# Timeframe dasar pasar (digunakan jika strategi tidak mendefinisikan TF khusus):
GLOBAL_MARKET_INTERVAL=5m

# Inversi Sinyal (true untuk membalik BUY -> SELL dan SELL -> BUY):
INVERT_SIGNALS=false

# Ambang batas minimal keyakinan sinyal global (0.00 s/d 1.00):
MIN_SIGNAL_CONFIDENCE=0.65

# Level Logging (DEBUG, INFO, WARNING, ERROR):
LOG_LEVEL=INFO
# LOG_FILENAME=botragram-custom.log


# =============================================================================
# 5. STRATEGY SPECIFIC PARAMETERS
# =============================================================================

# -----------------------------------------------------------------------------
# 5a. Pinbar & Engulfing EMA-RSI Pullback (pinbar_engulfing_ema_rsi)
# -----------------------------------------------------------------------------
# [A] TIMEFRAME & TREND FRAMEWORK
PIER_INTERVAL=5m                        # Timeframe eksekusi sinyal strategi
PIER_TREND_PERIOD=200                  # EMA Tren Makro (Filter arah tren mayor)
PIER_PULLBACK_PERIOD=21                # EMA Pullback Dinamis (Area pullback target)
PIER_REQUIRE_TREND_FILTER=true         # Filter Dual-EMA (Pullback EMA >= Macro EMA)
PIER_REQUIRE_KEY_LEVEL_LOCATION=true   # Wajibkan lokasi di EMA21 atau Swing Level
# PIER_SWING_LOOKBACK=15               # Jendela lookback swing pivot level (default: 15)

# [B] CANDLESTICK GEOMETRY & CONFIRMATION
PIER_REQUIRE_CONFIRMATION=false        # Konfirmasi breakout candle berikutnya (default: false)
# PIER_MIN_WICK_RATIO=0.60             # Minimal rasio ekor rejection pinbar (60%)
# PIER_MAX_OPPOSITE_WICK_RATIO=0.20    # Maksimal rasio ekor berlawanan (20%)
# PIER_MIN_ENGULFING_BODY_RATIO=1.05   # Rasio minimal body engulfing vs candle sebelumnya
PIER_PINBAR_MIN_RANGE_ATR=0.5          # Range minimal pinbar vs ATR (0.5x)
PIER_ENGULFING_MIN_BODY_ATR=0.5        # Body minimal engulfing vs ATR (0.5x)
# PIER_INCLUDE_STAR_PATTERNS=true      # Deteksi variasi Morning Star & Evening Star

# [C] LOCATION & PULLBACK TOLERANCES
PIER_LOCATION_TOLERANCE_PCT=0.030      # Toleransi lokasi persentase (3.0%)
PIER_LOCATION_ATR_MULTIPLIER=1.0       # Toleransi lokasi berbasis ATR (1.0x ATR)
PIER_PULLBACK_PROXIMITY_PCT=0.006      # Kedekatan pullback persentase (0.6%)
PIER_PULLBACK_ATR_MULTIPLIER=0.5       # Kedekatan pullback berbasis ATR (0.5x ATR)

# [D] MOMENTUM & VOLATILITY FILTERS (RSI, MACD, STOCH RSI, PSAR, NATR)
# PIER_RSI_PERIOD=14                   # Periode RSI (default: 14)
PIER_RSI_LONG_MIN=38.0                 # Batas bawah RSI Long (pullback terkonfirmasi)
PIER_RSI_LONG_MAX=58.0                 # Batas atas RSI Long (mencegah beli saat overbought)
PIER_RSI_SHORT_MIN=42.0                # Batas bawah RSI Short (mencegah jual saat oversold)
PIER_RSI_SHORT_MAX=62.0                # Batas atas RSI Short (pullback rally terkonfirmasi)
PIER_USE_MACD=true                     # Guard momentum MACD
# PIER_MACD_FAST_PERIOD=12
# PIER_MACD_SLOW_PERIOD=26
# PIER_MACD_SIGNAL_PERIOD=9
PIER_USE_STOCH_RSI=true                # Guard momentum Stochastic RSI
# PIER_STOCH_RSI_PERIOD=14
# PIER_STOCH_RSI_K_PERIOD=3
# PIER_STOCH_RSI_D_PERIOD=3
# PIER_STOCH_RSI_OVERBOUGHT=80.0
# PIER_STOCH_RSI_OVERSOLD=20.0
# PIER_USE_PARABOLIC_SAR=true          # Konfirmasi arah tren Parabolic SAR
PIER_MIN_NATR_THRESHOLD=0.0012         # Filter volatilitas pasar mati/flat (skala 5m: ~0.12%)

# [E] VOLUME & SENTIMENT FILTERS
# PIER_VOLUME_PERIOD=20                # Periode SMA volume
# PIER_VOLUME_MULTIPLIER=1.10          # Minimal volume spike (1.10x SMA)

# [F] DYNAMIC STRUCTURAL WALL TP & CLEARANCE (BOLLINGER BANDS)
PIER_USE_STRUCTURAL_TP=true            # Pangkas target TP di resisten/support BB terdekat
PIER_STRUCTURAL_TP_BUFFER_PCT=0.002    # Buffer jarak aman sebelum band (0.2%)
PIER_MIN_STRUCTURAL_RR=1.0             # Rasio R:R minimal setelah dipangkas struktur
PIER_BB_PERIOD=20                      # Periode Bollinger Bands untuk deteksi batas struktur
PIER_BB_STD_DEV=2.0                    # Standar deviasi Bollinger Bands
PIER_USE_HTF_STRUCTURAL_TP=true        # Pindai dinding resisten/support HTF 1h & BB 1h
PIER_HTF_BB_PERIOD=20                  # Periode Bollinger Bands untuk timeframe HTF 1h
PIER_HTF_BB_STD_DEV=2.0                # Standar deviasi Bollinger Bands HTF 1h

# [G] RISK, SIZING & EXECUTION CEILINGS
# PIER_MIN_CONFIDENCE=0.65             # Threshold keyakinan sinyal minimal (65%)
# PIER_ATR_PERIOD=14                   # Periode ATR untuk kalkulasi volatilitas SL
# PIER_ATR_SL_MULTIPLIER=0.5           # Multiplier buffer ATR pada swing SL (0.5x ATR)
# PIER_RISK_REWARD_RATIO=2.0           # Target teoritis Risk:Reward Ratio (1:2.0)
# PIER_MIN_SL_DISTANCE_PCT=0.0015      # Jarak SL minimal absolut (0.15% - skala 5m)
PIER_STOP_LOSS_PCT=0.012               # Plafon risiko Stop Loss (1.2% - default TF 5m; 1.8% untuk 15m)
PIER_TAKE_PROFIT_PCT=0.024             # Plafon reward Take Profit (2.4% -> RRR 1:2.0; 3.6% untuk 15m)

# [H] DEDICATED GLOBAL OVERRIDES (PORTFOLIO & PROTECTION)
# PIER_LEVERAGE=3                      # Override LEVERAGE khusus strategi PIER
# PIER_MAX_POSITION_SIZE_USDT=50.0     # Override MAX_POSITION_SIZE_USDT khusus PIER
# PIER_RISK_PER_TRADE_PCT=0.02         # Override RISK_PER_TRADE_PCT khusus PIER (2.0%)
# PIER_TRAILING_MODE=swing_pivot       # Override TRAILING_MODE (stepped / swing_pivot)
# PIER_TRAILING_SWING_WINDOW=5         # Override TRAILING_SWING_WINDOW
# PIER_TRAILING_BUFFER_PCT=0.0010      # Override TRAILING_BUFFER_PCT (0.10%)
# PIER_PARTIAL_TP_ENABLED=true         # Override PARTIAL_TP_ENABLED
# PIER_PARTIAL_TP_RATIO=0.80           # Override PARTIAL_TP_RATIO
# PIER_PARTIAL_TP_TRIGGER_PROGRESS=0.80# Override PARTIAL_TP_TRIGGER_PROGRESS
# PIER_ENABLE_EARLY_POSITION_EXIT=false# Override ENABLE_EARLY_POSITION_EXIT
# PIER_EARLY_EXIT_MIN_CONFIDENCE=0.75  # Override EARLY_EXIT_MIN_CONFIDENCE
# PIER_EARLY_EXIT_CHECK_CANDLESTICK_REVERSAL=false
# PIER_EARLY_EXIT_CHECK_OPPOSITE_SIGNAL=false
# PIER_EARLY_EXIT_CHECK_EXHAUSTION=true

# [I] SETUP STALKING & HTF EXTREME RADAR
PIER_REQUIRE_HTF_EXTREME_ZONE=true     # Wajibkan harga berada di zona ekstrem HTF (Upper/Lower Band)
PIER_HTF_EXTREME_BUFFER_ATR=0.20       # Buffer penetrasi batas ekstrem berbasis ATR HTF (0.20x)
PIER_STRICT_EMA_SIDE_REJECTION=true    # Rejection wajib ditutup di sisi yang benar dari EMA21
PIER_STALKING_ENABLED=true             # Mode pengamatan retest bar lanjutan (1-7 bar)
PIER_STALKING_MAX_BARS=7               # Jendela pengamatan maksimal sebelum sinyal hangus (1-7 bar)
PIER_STALKING_MAX_CANDIDATES=5         # Jumlah maksimal kandidat stalking simultan pada radar (misal 1-50)
PIER_STALKING_RETEST_RATIO=0.50        # Rasio retest target ke dalam body pola (50% pullback)


# -----------------------------------------------------------------------------
# 5b. Smart Money Concepts (choch_fvg)
# -----------------------------------------------------------------------------
# CHOCH_INTERVAL=5m
# CHOCH_SWING_WINDOW=5                 # Window bar untuk Swing High/Low (default: 5)
# CHOCH_FVG_LOOKBACK=20                # Jendela candle mundur untuk Fair Value Gap (default: 20)
# CHOCH_MIN_BODY_RATIO=0.50            # Rasio minimal body candle breakout (default: 0.50)
# CHOCH_VOLUME_MULTIPLIER=1.20         # Pengali lonjakan volume candle displacement (default: 1.20)


# -----------------------------------------------------------------------------
# 5c. Market Orderflow Regime & Price-Hunt (morph)
# -----------------------------------------------------------------------------
# MORPH_INTERVAL=15m
# MORPH_SWING_LOOKBACK=15              # Lookback window untuk swing high / swing low
# MORPH_FVG_LOOKBACK=20                # Jendela candle mundur untuk FVG retest
# MORPH_USE_FVG=true                   # Aktifkan konfirmasi Fair Value Gap
# MORPH_MIN_WICK_RATIO=0.50            # Rasio minimal ekor rejection pinbar (50%)
# MORPH_VOLUME_MULTIPLIER=1.15         # Pengali lonjakan volume minimal
# MORPH_ATR_MULTIPLIER_SL=0.8          # Buffer volatilitas ATR pada stop loss
# MORPH_RISK_REWARD_RATIO=2.0          # Target Risk-Reward Ratio (1:2.0)
# MORPH_TREND_PERIOD=200               # Periode EMA tren makro
# MORPH_INTERMEDIATE_TREND_PERIOD=50   # Periode EMA tren intermediate
# MORPH_REQUIRE_TREND_FILTER=true      # Wajibkan sinyal searah tren makro EMA 200/50
# MORPH_MIN_NATR_THRESHOLD=0.0020      # Minimal NATR (filter pasar mati/sideways flat)


# -----------------------------------------------------------------------------
# 5d. New York 4H Range Scalping (ny_4h_range_scalping)
# -----------------------------------------------------------------------------
# NY_RANGE_INTERVAL=5m
# NY_RANGE_RISK_REWARD_RATIO=0.8       # Target Risk-Reward Ratio (1:0.8)
# NY_RANGE_MAX_SL_PCT=0.03             # Batas maksimal jarak Stop Loss (3.0%)
# NY_RANGE_MIN_SL_PCT=0.015            # Batas minimal jarak Stop Loss (1.5%)
# NY_RANGE_FALLBACK_SL_PCT=0.015       # Fallback Stop Loss jika swing invalid (1.5%)
# NY_RANGE_MAX_BREAKOUT_BARS=12        # Maksimal candle 5M breakout sebelum re-entry
# NY_RANGE_MIN_CONFIDENCE=0.75         # Threshold minimal confidence sinyal (75%)
# NY_RANGE_BASE_CONFIDENCE=0.70        # Base confidence sinyal setup valid (70%)
# NY_RANGE_USE_VOLUME_FILTER=true      # Aktifkan konfirmasi volume pada candle re-entry
# NY_RANGE_VOLUME_PERIOD=20            # Periode SMA volume (20 candle 5M)
# NY_RANGE_VOLUME_MULTIPLIER=1.0       # Multiplier volume vs SMA (1.0x)
# NY_RANGE_VOLUME_CONFIDENCE_BONUS=0.10# Bonus confidence jika volume terkonfirmasi (+10%)
# NY_RANGE_REQUIRE_VOLUME_CONFIRMATION=false
# NY_RANGE_REQUIRE_TREND_FILTER=true   # Filter arah tren (EMA 50 pada close)
# NY_RANGE_TREND_EMA_PERIOD=50         # Periode EMA untuk filter tren
# NY_RANGE_USE_RSI_FILTER=true         # Filter momentum RSI untuk validasi re-entry
# NY_RANGE_RSI_PERIOD=14               # Periode RSI (14 candle 5M)
# NY_RANGE_RSI_LONG_MAX=54.0           # Batas maksimal RSI untuk entry Long
# NY_RANGE_RSI_SHORT_MIN=44.0          # Batas minimal RSI untuk entry Short


# -----------------------------------------------------------------------------
# 5e. Botragram Origin Price Action (botragram_origin)
# -----------------------------------------------------------------------------
# ORIGIN_INTERVAL=3m
# ORIGIN_RISK_REWARD_RATIO=1.5         # Target Risk-Reward Ratio (1:1.5)
# ORIGIN_MIN_SL_PCT=0.010              # Batas minimal jarak Stop Loss (1.0%)
# ORIGIN_MAX_SL_PCT=0.030              # Batas maksimal jarak Stop Loss (3.0%)
# ORIGIN_FALLBACK_SL_PCT=0.015         # Fallback Stop Loss jika swing invalid (1.5%)
# ORIGIN_STOP_LOSS_PCT=0.03            # Override Stop Loss eksplisit (3.0%)
# ORIGIN_TAKE_PROFIT_PCT=0.045         # Override Take Profit eksplisit (4.5%)
# ORIGIN_MIN_CONFIDENCE=0.75           # Threshold minimal confidence sinyal (75%)
# ORIGIN_USE_TREND_FILTER=true         # Filter arah tren makro
# ORIGIN_TREND_EMA_PERIOD=14           # Periode EMA untuk filter tren
# ORIGIN_USE_VOLUME_FILTER=true        # Filter konfirmasi volume
# ORIGIN_VOLUME_PERIOD=20              # Periode SMA volume
# ORIGIN_VOLUME_MULTIPLIER=1.1         # Multiplier lonjakan volume vs SMA
# ORIGIN_USE_RSI_FILTER=false          # Filter momentum RSI
# ORIGIN_RSI_PERIOD=14                 # Periode RSI
# ORIGIN_RSI_LONG_MAX=90.0             # Batas maksimal RSI untuk entry Long
# ORIGIN_RSI_SHORT_MIN=20.0            # Batas minimal RSI untuk entry Short
# ORIGIN_REQUIRE_RSI_DIRECTION=true    # Wajib RSI berbalik arah
# ORIGIN_USE_BB_FILTER=true            # Filter Bollinger Bands
# ORIGIN_BB_PERIOD=20                  # Periode Bollinger Bands
# ORIGIN_BB_STD_DEV=2.0                # Multiplier deviasi standar Bollinger Bands
# ORIGIN_USE_MACD_FILTER=true          # Filter arah momentum MACD
# ORIGIN_MACD_FAST_PERIOD=12           # Periode Fast EMA MACD
# ORIGIN_MACD_SLOW_PERIOD=26           # Periode Slow EMA MACD
# ORIGIN_MACD_SIGNAL_PERIOD=9          # Periode Signal EMA MACD
# ORIGIN_USE_PSAR_FILTER=false         # Filter Parabolic SAR
# ORIGIN_PSAR_MAX_PROXIMITY_PCT=0.012  # Toleransi jarak SAR (1.2%)


# -----------------------------------------------------------------------------
# 5f. Generic Strategy Overrides (Optional Fallbacks)
# -----------------------------------------------------------------------------
# Scalping strategies override (rsi_bb_scalping, ema_scalping, vwap_breakout):
# SCALPING_INTERVAL=5m
# SCALPING_FAST_PERIOD=5
# SCALPING_SLOW_PERIOD=13
# SCALPING_REQUIRE_TREND_FILTER=true
# SCALPING_TREND_PERIOD=200
# SCALPING_STOP_LOSS_PCT=0.025
# SCALPING_TAKE_PROFIT_PCT=0.03

# Trend strategies override (ichimoku, supertrend, ema_cross, adx, ema_rsi, bb):
# TREND_INTERVAL=15m
# TREND_STOP_LOSS_PCT=0.015
# TREND_TAKE_PROFIT_PCT=0.03

# Swing strategies override (macd_swing):
# SWING_INTERVAL=1h
# SWING_STOP_LOSS_PCT=0.025
# SWING_TAKE_PROFIT_PCT=0.05

# Global fallback exits override (ratios: 0.02 = 2%, 0.04 = 4%):
# STOP_LOSS_PCT=0.02
# TAKE_PROFIT_PCT=0.04


# =============================================================================
# 6. MULTI-TIMEFRAME & BENCHMARK CONFIRMATION
# =============================================================================
# Filter keselarasan tren pada timeframe yang lebih tinggi (HTF):
MTF_CONFIRMATION_ENABLED=true
MTF_TIMEFRAME=1h
MTF_EMA_PERIOD=50

# Filter konfirmasi mikro pada timeframe yang lebih rendah (LTF):
# Memvalidasi arah candle mikro atau keselarasan micro-trend sebelum entry.
# Mode pilihan: direction (candle mikro searah), ema (close vs micro EMA), both (keduanya)
LTF_CONFIRMATION_ENABLED=false
LTF_TIMEFRAME=3m
LTF_CONFIRMATION_MODE=direction
LTF_EMA_PERIOD=9

# Benchmark Market Trend Filter (BTC Trend Alignment):
# Menolak SHORT pada altcoin jika BTC uptrend, menolak BUY jika BTC downtrend.
BTC_TREND_FILTER_ENABLED=true
BTC_TREND_INTERVAL=15m
BTC_TREND_EMA_PERIOD=50


# =============================================================================
# 7. DERIVATIVES ORDERFLOW & SENTIMENT FILTERS
# =============================================================================
# A. Open Interest (OI) Confluence:
USE_OPEN_INTEREST=true
MIN_OI_CHANGE_PCT=0.0005
REQUIRE_OI_CONFLUENCE=true

# B. Funding Rate Crowding Sentiment Filter:
FILTER_FUNDING_SENTIMENT=true
MAX_LONG_FUNDING_RATE=0.0005           # Tolak BUY jika funding > +0.05%
MIN_SHORT_FUNDING_RATE=-0.0005         # Tolak SELL jika funding < -0.05%
REQUIRE_FUNDING_SENTIMENT=true

# C. Long-Short Account Ratio Sentiment Filter:
FILTER_ACCOUNT_RATIO=true
MAX_LONG_ACCOUNT_RATIO=0.70            # Tolak BUY jika mayoritas akun net long (> 70%)
MIN_SHORT_ACCOUNT_RATIO=0.30           # Tolak SELL jika mayoritas akun net short (< 30%)
REQUIRE_ACCOUNT_RATIO_CONFLUENCE=true
CONFIRM_HTF_ACCOUNT_RATIO=true
ACCOUNT_RATIO_HTF_PERIOD=1h


# =============================================================================
# 8. PORTFOLIO & RISK SAFEGUARDS
# =============================================================================
MAX_OPEN_POSITIONS=10                  # Maksimal posisi aktif simultan
MAX_POSITION_SIZE_USDT=50              # Plafon notional per posisi (USDT)
RISK_PER_TRADE_PCT=0.03                # Budget risiko per trade (3.0% equity)
MAX_DRAWDOWN_PCT=0.05                  # Batas drawdown portofolio (5.0%)
LEVERAGE=3                             # Default leverage dasar
MAX_EXECUTABLE_QUOTE_AGE_MS=15000      # Maksimal umur data harga eksekusi (15 detik)
MAX_SPREAD_BPS=20                      # Maksimal spread bid-ask (20 bps / 0.20%)


# =============================================================================
# 9. POSITION PROTECTION & EXIT HARDENING
# =============================================================================
# A. Trailing Stop Mode (Stepped vs Dynamic Swing Pivot):
TRAILING_MODE=swing_pivot              # Mode trailing: 'swing_pivot' (anti-wick lembah baru) atau 'stepped'
TRAILING_SWING_TIMEFRAME=5m            # Timeframe deteksi swing pivot (5m atau 3m)
TRAILING_SWING_WINDOW=5                # Window fractal swing pivot (5-bar fractal)
TRAILING_BUFFER_PCT=0.0015             # Buffer napas di bawah lembah / di atas puncak (0.15%)

# Stepped Trailing Stop Parameters (berfungsi jika TRAILING_MODE=stepped):
STEPPED_STOP_ENABLED=true
STEPPED_STOP_THRESHOLDS=0.30,0.45,0.60,0.75,0.90
STEPPED_STOP_LOCKED_LAG=0.20
BREAKEVEN_PROGRESS_THRESHOLD=0.35      # Kunci ke BE+ ketika progress TP mencapai 35% (leverage-agnostic)
BREAKEVEN_ROI_THRESHOLD=0.50           # Fallback ROI jika progress threshold tidak tercapai
BREAKEVEN_FEE_BUFFER=0.0016            # Buffer biaya trading (0.16%)

# B. Partial Take Profit (Scaling Out):
PARTIAL_TP_ENABLED=true
PARTIAL_TP_RATIO=0.80                  # Tutup 80% posisi saat trigger tercapai
PARTIAL_TP_TRIGGER_PROGRESS=0.80       # Memicu Partial TP pada 80% jarak TP

# C. Early In-Flight Position Invalidation:
ENABLE_EARLY_POSITION_EXIT=false       # Matikan agar setup 15m tidak terpotong noise
EARLY_EXIT_MIN_CONFIDENCE=0.75
EARLY_EXIT_CHECK_CANDLESTICK_REVERSAL=false
EARLY_EXIT_CHECK_OPPOSITE_SIGNAL=false
EARLY_EXIT_CHECK_EXHAUSTION=true       # Exit dini jika indikator multi-confluence jenuh/exhausted


# =============================================================================
# 10. DYNAMIC SIZING & ADAPTIVE LEVERAGE
# =============================================================================
# Sizing berbasis skor keyakinan (Confidence):
DYNAMIC_SIZING_ENABLED=true
CONFIDENCE_SIZING_ENABLED=true
BASELINE_CONFIDENCE=0.70
MAX_CONFIDENCE_MULTIPLIER=1.50

# Adaptive Leverage berdasar volatilitas:
DYNAMIC_LEVERAGE_ENABLED=true
MIN_LEVERAGE=3
MAX_LEVERAGE=8

# Equal Margin Allocation per Sisa Slot:
SLOT_SIZING_ENABLED=true
SLOT_MARGIN_BUFFER_PCT=0.053
MIN_ORDER_NOTIONAL_USDT=10.0

# Volatility-Adjusted Sizing:
VOLATILITY_SIZING_ENABLED=true
BASELINE_VOLATILITY_PCT=0.02


# =============================================================================
# 11. OPPORTUNITY DISCOVERY & UNIVERSE SCANNER
# =============================================================================
DISCOVERY_FILTER_EXTREME_VOLATILITY=true
DISCOVERY_MAX_CANDLE_VOLATILITY_PCT=0.15
DISCOVERY_FILTER_MIN_LIQUIDITY=true
DISCOVERY_MIN_QUOTE_VOLUME_USDT=3000
DISCOVERY_USE_DYNAMIC_VOLUME=true
DISCOVERY_VOLUME_SMA_PERIOD=20
DISCOVERY_MIN_24H_TURNOVER_USDT=864000

# Rotasi Universe:
DISCOVERY_UNIVERSE_LIMIT=750
DISCOVERY_BATCH_SIZE=10
DISCOVERY_MAX_UNIVERSE_SYMBOLS=750
DISCOVERY_CADENCE_SECONDS=1
DISCOVERY_CANDLE_DELAY_SECONDS=0.18

# Database Candle Retention:
CANDLE_RETENTION_DAYS=7
CANDLE_PRUNING_INTERVAL_HOURS=6


# =============================================================================
# 12. EXCHANGE PRODUCTS & CFD CONFIGURATION
# =============================================================================
# Binance:
BINANCE_MARKET_TYPE=FUTURES

# Bybit:
BYBIT_MARKET_TYPE=FUTURES
# BYBIT_DEMO=false

# Bitget:
BITGET_MARKET_TYPE=FUTURES
BITGET_CFD_MODE=ecn
# BITGET_API_KEY=your_bitget_api_key_here
# BITGET_API_SECRET=your_bitget_api_secret_here
# BITGET_PASSPHRASE=your_bitget_passphrase_here
# BITGET_TESTNET=false
