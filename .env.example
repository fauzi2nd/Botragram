# =============================================================================
# Botragram Environment Configuration
# =============================================================================

# Supported values: TESTNET, MAINNET
# Credentials are loaded from .env.testnet or .env.mainnet.
BOTRAGRAM_PROFILE=TESTNET

# Optional bootstrap selector for the dedicated autonomous TESTNET soak base file.
# Set this in the process environment before startup, not here: dotenv is loaded
# only after this selection is resolved.
# BOTRAGRAM_ENV_FILE=.env.autonomous_testnet_soak

# Active Exchange (only BINANCE is fully wired by DependencyProvider)
ACTIVE_EXCHANGE=BINANCE

# Telegram Bot Credentials
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Application Settings
TRADE_MODE=PAPER
# Enable only PAPER market-wide opportunity execution.
AUTONOMOUS_EXECUTION_ENABLED=false
# Base explicit opt-in required for autonomous LIVE entry.
AUTONOMOUS_LIVE_ENTRY_ENABLED=false
# Additional fail-closed opt-in required only for autonomous MAINNET entry.
AUTONOMOUS_MAINNET_ENTRY_ENABLED=false
# Optional: single_symbol, autonomous_paper, autonomous_live, or human_confirmed_paper.
# Leave blank to preserve the legacy autonomous flag behavior.
EXECUTION_POLICY=autonomous_live
# Supported strategy types:
# Scalping:     ema_scalping, rsi_bb_scalping, vwap_breakout (Auto-TF: 5m | Default RRR 1:2)
# Price Action: choch_fvg (Smart Money Concepts: CHoCH + FVG Retest | Auto-TF: 5m | Default RRR 1:2.5)
# Trend:        ema_cross, ema_rsi, ichimoku_cloud, supertrend, adx_trend, bollinger_breakout (Auto-TF: 15m | Default RRR 1:2)
# Swing:        macd_swing (Auto-TF: 1h | Default RRR 1:2)
STRATEGY_TYPE=choch_fvg
# Set to true to invert all generated signals (BUY -> SELL, SELL -> BUY)
INVERT_SIGNALS=false
LOG_LEVEL=INFO

# =============================================================================
# Strategy Risk Profiles (Optional Custom Override - Default RRR 1:2 / 1:2.5)
# =============================================================================
# Botragram secara otomatis menerapkan RRR optimal untuk setiap kategori strategi:
#   • Scalping:     SL 0.5% / TP 1.0% (RRR 1:2)
#   • Price Action: SL 1.0% / TP 2.5% (RRR 1:2.5) -> choch_fvg
#   • Trend:        SL 1.5% / TP 3.0% (RRR 1:2)
#   • Swing:        SL 2.5% / TP 5.0% (RRR 1:2)
#
# Buka tanda pagar (#) di bawah HANYA jika Anda ingin melakukan custom override:
#
# 1. Scalping strategies override (rsi_bb_scalping, ema_scalping, vwap_breakout)
# SCALPING_STOP_LOSS_PCT=0.005
# SCALPING_TAKE_PROFIT_PCT=0.01
#
# 2. Trend following strategies override (ichimoku_cloud, supertrend, ema_cross, adx_trend, ema_rsi, bollinger_breakout)
# TREND_STOP_LOSS_PCT=0.015
# TREND_TAKE_PROFIT_PCT=0.03
#
# 3. Swing trading strategies override (macd_swing)
# SWING_STOP_LOSS_PCT=0.025
# SWING_TAKE_PROFIT_PCT=0.05
#
# 4. Global fallback exits override (ratios: 0.02 = 2%, 0.04 = 4%)
# STOP_LOSS_PCT=0.02
# TAKE_PROFIT_PCT=0.04
#
# 5. Smart Money Concepts / Price Action Strategy Parameters (choch_fvg)
# CHOCH_SWING_WINDOW=5          # Lookback bar window untuk mendeteksi Swing High / Swing Low (default: 5)
# CHOCH_FVG_LOOKBACK=20         # Jendela candle mundur untuk memetakan Fair Value Gap / Imbalance (default: 20)
# CHOCH_MIN_BODY_RATIO=0.50     # Rasio minimal body candle breakout (displacement quality) (default: 0.50)
# CHOCH_VOLUME_MULTIPLIER=1.20  # Rasio lonjakan volume candle displacement vs SMA volume (default: 1.20)

# Portfolio and MARKET-entry safeguards.
# For autonomous LIVE these values are both the startup runtime values and the
# immutable hard ceilings. Telegram may lower/raise durable runtime values only
# within these ceilings while trading is PAUSED; no restart is required.
MAX_OPEN_POSITIONS=3
MAX_POSITION_SIZE_USDT=10
RISK_PER_TRADE_PCT=0.02
MAX_DRAWDOWN_PCT=0.10
LEVERAGE=1
# Reject execution references older than this limit or with a wider spread.
MAX_EXECUTABLE_QUOTE_AGE_MS=1000
MAX_SPREAD_BPS=20

# Autonomous LIVE ranked discovery rotation.
# DISCOVERY_UNIVERSE_LIMIT is retained for compatibility/telemetry; autonomous
# LIVE rotates bounded batches across the complete active ranked Futures universe.
DISCOVERY_UNIVERSE_LIMIT=100
DISCOVERY_BATCH_SIZE=20
# Optional autonomous discovery cadence in seconds; leave blank for interval cadence.
DISCOVERY_CADENCE_SECONDS=10

# =============================================================================
# Binance Product
# =============================================================================
# Supported values: SPOT, FUTURES (USD(S)-M perpetual futures)
BINANCE_MARKET_TYPE=FUTURES
