# =====================================================
# Trading Bot Configuration
# =====================================================

# ==========================
# Application
# ==========================
APP_NAME=TradingBot
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=UTC

# ==========================
# Exchange
# ==========================
EXCHANGE=bybit
ACCOUNT_TYPE=UNIFIED
TESTNET=false

# ==========================
# API
# ==========================
API_KEY=
API_SECRET=
API_PASSPHRASE=

# ==========================
# Trading
# ==========================
DEFAULT_SYMBOL=BTC/USDT
DEFAULT_TIMEFRAME=15m

INITIAL_BALANCE=1000

RISK_PER_TRADE=1.0
MAX_OPEN_POSITIONS=1

# ==========================
# Telegram
# ==========================
TELEGRAM_ENABLED=true

TELEGRAM_BOT_TOKEN=

TELEGRAM_CHAT_ID=

# ==========================
# Logging
# ==========================
LOG_LEVEL=INFO

LOG_DIRECTORY=logs

LOG_RETENTION=30 days

LOG_ROTATION=10 MB

# ==========================
# Database
# ==========================
DATABASE_PATH=storage/database/trading.db

# ==========================
# Candle Storage
# ==========================
DATA_DIRECTORY=storage/files

CACHE_DIRECTORY=storage/cache

# ==========================
# Backtest
# ==========================
BACKTEST_INITIAL_BALANCE=1000

BACKTEST_COMMISSION=0.001

BACKTEST_SLIPPAGE=0.0005