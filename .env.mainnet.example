# =============================================================================
# Botragram Mainnet Credentials
# Copy this file to .env.mainnet and replace the placeholders.
# Never use this profile until live access is explicitly intended.
# =============================================================================

# Binance Mainnet
BINANCE_API_KEY=your_binance_mainnet_api_key_here
BINANCE_API_SECRET=your_binance_mainnet_api_secret_here
BINANCE_TESTNET=false

# Bybit Mainnet
BYBIT_API_KEY=your_bybit_mainnet_api_key_here
BYBIT_API_SECRET=your_bybit_mainnet_api_secret_here
BYBIT_TESTNET=false

# OKX Mainnet
OKX_API_KEY=your_okx_mainnet_api_key_here
OKX_API_SECRET=your_okx_mainnet_api_secret_here
OKX_PASSPHRASE=your_okx_mainnet_passphrase_here
OKX_TESTNET=false

# Bitget Mainnet
BITGET_API_KEY=your_bitget_mainnet_api_key_here
BITGET_API_SECRET=your_bitget_mainnet_api_secret_here
BITGET_PASSPHRASE=your_bitget_mainnet_passphrase_here
BITGET_TESTNET=false
