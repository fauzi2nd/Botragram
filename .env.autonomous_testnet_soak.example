# =============================================================================
# Dedicated autonomous FUTURES TESTNET soak configuration
# =============================================================================
# Copy to .env.autonomous_testnet_soak. Select it explicitly with:
# $env:BOTRAGRAM_ENV_FILE = '.env.autonomous_testnet_soak'
#
# Its isolated TESTNET credentials belong only in the sibling
# .env.autonomous_testnet_soak.testnet file. Never put MAINNET credentials here.

BOTRAGRAM_PROFILE=TESTNET
ACTIVE_EXCHANGE=BINANCE
TRADE_MODE=LIVE
EXECUTION_POLICY=autonomous_live
AUTONOMOUS_EXECUTION_ENABLED=false
AUTONOMOUS_LIVE_ENTRY_ENABLED=true
BINANCE_MARKET_TYPE=FUTURES

# Conservative existing risk controls for a TESTNET soak.
MAX_POSITION_SIZE_USDT=10
MAX_OPEN_POSITIONS=1
EMA_SCALPING_STOP_LOSS_PCT=0.005
EMA_SCALPING_TAKE_PROFIT_PCT=0.01
LOG_LEVEL=INFO
